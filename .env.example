# Copy to .env and fill in. Never commit real keys.
# Get a key via the Nebius Builder Program: https://dev.nebius.com

# Nebius Token Factory API key (required)
NEBIUS_API_KEY=

# Optional: some accounts need the project id on Sandboxes calls (shown in console)
NEBIUS_PROJECT_ID=

# Token Factory inference base URL (OpenAI-compatible). Confirmed from Nebius docs.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# --- Dev fallback backend (while Nebius signup is under maintenance) ---
# ANVIL_LLM_BACKEND=nvidia uses NVIDIA build.nvidia.com instead of Nebius.
# Get a key at https://build.nvidia.com/settings/api-keys (starts with nvapi-).
# NOTE: the hackathon submission MUST use the nebius backend (rules require a
# runtime call to the Token Factory API). nvidia is for development only.
# ANVIL_LLM_BACKEND=nvidia
# NVIDIA_API_KEY=<redacted>
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA open-source models served on Nebius (re-verify IDs with GET /v1/models)
ANVIL_MODEL_PLAN=nvidia/Nemotron-3-Ultra-550b-a55b
ANVIL_MODEL_CODE=nvidia/nemotron-3-super-120b-a12b
ANVIL_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Optional: Tavily API key enables the agent's web-research tool
TAVILY_API_KEY=

# Agent behavior
ANVIL_MAX_ITERATIONS=8
ANVIL_SANDBOX_TIMEOUT_S=180
